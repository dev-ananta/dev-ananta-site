# Copy to .env for local use. On Vercel, set these under
# Project → Settings → Environment Variables. All are optional.

# Absolute site URL used for canonical/OG tags. Defaults to https://dev-ananta.vercel.app
SITE_URL=https://dev-ananta.vercel.app

# Dev server port (npm run dev). Defaults to 3000.
PORT=3000

# ── Document 4: Personal mode (INACTIVE) ─────────────────────────────────
# Uncomment only after following personal/README.md.
# SITE_MODE=personal
# PERSONAL_URL=https://personal-dev-ananta.vercel.app
# PROFESSIONAL_URL=https://dev-ananta.vercel.app

# ── Contact form (api/contact.js) ────────────────────────────────────────
# RESEND_API_KEY=re_xxxxxxxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Portfolio <hello@yourdomain.com>

# ── Optional bot protection (Cloudflare Turnstile) ──────────────────────
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
